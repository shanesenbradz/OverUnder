Underover native build fixes on top of vendor/melonds/bullpup.patch:
- JIT code memory comes from an anonymous mapping on Android, not the library bss
- a line skipped by frame skip still takes its line from the threaded 3D renderer, so the
  next shown frame never reads 3D lines before they are drawn (black bands at the bottom)

--- a/src/ARMJIT_Global.cpp
+++ b/src/ARMJIT_Global.cpp
@@ -21,7 +21,7 @@
 
 std::mutex globalMutex;
 
-#if !defined(__APPLE__) && !defined(__NetBSD__) && !defined(__OpenBSD__)
+#if !defined(__APPLE__) && !defined(__NetBSD__) && !defined(__OpenBSD__) && !defined(__ANDROID__)
 static constexpr size_t NumCodeMemSlices = 4;
 static constexpr size_t CodeMemoryAlignedSize = NumCodeMemSlices * CodeMemorySliceSize;
 
@@ -42,7 +42,7 @@
 {
     std::lock_guard guard(globalMutex);
 
-#if !defined(__APPLE__) && !defined(__NetBSD__) && !defined(__OpenBSD__)
+#if !defined(__APPLE__) && !defined(__NetBSD__) && !defined(__OpenBSD__) && !defined(__ANDROID__)
     if (AvailableCodeMemSlices)
     {
         int slice = __builtin_ctz(AvailableCodeMemSlices);
@@ -69,7 +69,7 @@
 {
     std::lock_guard guard(globalMutex);
 
-#if !defined(__APPLE__) && !defined(__NetBSD__) && !defined(__OpenBSD__)
+#if !defined(__APPLE__) && !defined(__NetBSD__) && !defined(__OpenBSD__) && !defined(__ANDROID__)
     for (int i = 0; i < NumCodeMemSlices; i++)
     {
         if (codeMem == &GetAlignedCodeMemoryStart()[CodeMemorySliceSize * i])
@@ -98,8 +98,8 @@
         #ifdef _WIN32
             DWORD dummy;
             VirtualProtect(GetAlignedCodeMemoryStart(), CodeMemoryAlignedSize, PAGE_EXECUTE_READWRITE, &dummy);
-        #elif defined(__APPLE__) || defined(__NetBSD__) || defined(__OpenBSD__)
-            // these platforms always use dynamic allocation
+        #elif defined(__APPLE__) || defined(__NetBSD__) || defined(__OpenBSD__) || defined(__ANDROID__)
+            // these platforms always use dynamic allocation (Android: an anonymous mapping, not the library's bss)
         #else
             mprotect(GetAlignedCodeMemoryStart(), CodeMemoryAlignedSize, PROT_EXEC | PROT_READ | PROT_WRITE);
         #endif
--- a/src/GPU.h
+++ b/src/GPU.h
@@ -851,6 +851,9 @@
     virtual void DrawSprites(u32 line) = 0;
 
     virtual void Start3DRendering() { Rend3D->RenderFrame(); }
+    // Underover: a line whose 2D drawing is skipped still takes its 3D line, so the threaded
+    // 3D renderer's line count stays in step (otherwise the next shown frame reads lines early)
+    void Skip3DLine(u32 line) { if (Rend3D && line < 192) Rend3D->GetLine(line); }
     virtual void Finish3DRendering() { Rend3D->FinishRendering(); }
     virtual void Restart3DRendering() { Rend3D->RestartFrame(); }
 
--- a/src/GPU.cpp
+++ b/src/GPU.cpp
@@ -1160,6 +1160,8 @@
             Rend->DrawScanline(line);
         if (line < 191 && !skip)
             Rend->DrawSprites(line+1);
+        if (skip)
+            Rend->Skip3DLine(VCount);
 
         NDS.CheckDMAs(0, 0x02);
     }
